{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapcreator.local/schemas/kinds/road.schema.json",
  "title": "RoadAttrs",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "surface": { "enum": ["paved", "unpaved"] },
    "lanes": { "type": "integer", "minimum": 1, "maximum": 12 },
    "speed_limit": { "type": "integer", "minimum": 0 },
    "toll": { "type": "boolean", "default": false }
  }
}
