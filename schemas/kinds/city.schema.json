{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapcreator.local/schemas/kinds/city.schema.json",
  "title": "CityAttrs",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "population": { "type": "integer", "minimum": 0 },
    "capital": { "type": "boolean" },
    "founded": { "type": "string", "pattern": "^[0-9]{1,4}(-[0-9]{2})?(-[0-9]{2})?$" },
    "elevation_m": { "type": "number" },
    "faction": { "type": "string" }
  }
}
