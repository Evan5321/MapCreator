{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapcreator.local/schemas/annotation.schema.json",
  "title": "Annotation",
  "description": "标注（API 与导入导出使用）。名称在 names 中，名称是唯一必需的显示字段。",
  "type": "object",
  "required": ["id", "kind", "lon", "lat", "names"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^anno\\.[a-z_]+(\\.[a-z0-9_]+)+$" },
    "kind": { "type": "string", "minLength": 1 },
    "parent_id": { "type": ["string", "null"] },
    "geometry_id": {
      "type": ["string", "null"],
      "pattern": "^geo\\.[a-z_]+(\\.[a-z0-9_]+)+$",
      "description": "点标注必须为 null（D-015）"
    },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "label_mode": { "enum": ["point", "line", "none"], "default": "point" },
    "rank": { "type": "integer", "minimum": 1, "maximum": 5, "default": 3 },
    "min_zoom": { "type": ["number", "null"], "minimum": 0, "maximum": 24 },
    "max_zoom": { "type": ["number", "null"], "minimum": 0, "maximum": 24 },
    "icon": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "attrs": { "type": "object", "default": {} },
    "revision": { "type": "integer", "minimum": 1, "default": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "deleted_at": { "type": ["string", "null"], "format": "date-time" },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "annotation-name.schema.json" },
      "description": "至少一个主名；is_primary 必须恰好一个（构建期强校验）"
    }
  }
}
