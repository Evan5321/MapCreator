# 统一换行：文本用 LF，避免 Windows 上 CRLF 污染 diff
* text=auto eol=lf

# 明确文本类型
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf
*.sql  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 二进制资产：不做换行转换，diff 只报"已更改"
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.pbf  binary
*.mbtiles binary
*.pmtiles binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
